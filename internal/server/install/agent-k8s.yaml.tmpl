# safe-agent：Kubernetes 节点上的主机 Agent（每个节点一个）。
#
# 安装（管理员在控制台"节点管理"生成 Agent 注册令牌，使用次数不少于节点数）：
#   kubectl create namespace safe-system
#   kubectl -n safe-system create secret generic safe-enroll --from-literal=token='<注册令牌>'
#   curl -fsSLk --pinnedpubkey '{{.Pin}}' {{.ServerURL}}/install/agent-k8s.yaml | kubectl apply -f -
# 注册完成后可删除 Secret（证书保存在节点的 /var/lib/safe-agent-k8s，重建 Pod 不需要令牌）。
# 卸载：kubectl delete namespace safe-system，再在各节点删除 /var/lib/safe-agent-k8s。
#
# 工作方式：init 容器从管理中心下载 Agent（校验管理中心公钥指纹）到节点的 /var/lib/safe-agent-k8s/bin；
# 主容器用 nsenter 进入节点的挂载 / 网络等命名空间运行它，行为与在节点上直接安装完全相同：
# 读取节点的登录日志与关键文件、审计节点上（含所有容器内）执行的命令、在节点上执行处置。
# 因此需要特权容器、hostPID 和 hostNetwork。
# 不要在同一节点上同时用一行命令安装 Agent：两个 Agent 会重复上报。
# 内网无法访问 Docker Hub 时，把下面两个镜像同步到内部镜像仓库并修改 image。
---
apiVersion: v1
kind: Namespace
metadata:
  name: safe-system
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: safe-agent
  namespace: safe-system
  labels: {app: safe-agent}
spec:
  selector:
    matchLabels: {app: safe-agent}
  updateStrategy:
    type: RollingUpdate
  template:
    metadata:
      labels: {app: safe-agent}
    spec:
      hostPID: true
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
      priorityClassName: system-node-critical
      automountServiceAccountToken: false
      tolerations:
        - operator: Exists # 包括控制平面和有污点的节点
      terminationGracePeriodSeconds: 15
      initContainers:
        - name: download
          image: curlimages/curl:8.11.1
          securityContext: {runAsUser: 0}
          env:
            - {name: SERVER, value: "{{.ServerURL}}"}
            - {name: PIN, value: "{{.Pin}}"}
          command:
            - sh
            - -ec
            - |
              case "$(uname -m)" in
                x86_64|amd64) A=amd64 ;;
                aarch64|arm64) A=arm64 ;;
                *) echo "unsupported architecture $(uname -m)"; exit 1 ;;
              esac
              mkdir -p /state/bin
              curl -fsSk --pinnedpubkey "$PIN" -o /state/bin/safe-agent.new "$SERVER/download/safe-agent-linux-$A"
              chmod 755 /state/bin/safe-agent.new
              mv /state/bin/safe-agent.new /state/bin/safe-agent
          volumeMounts:
            - {name: state, mountPath: /state}
      containers:
        - name: agent
          image: debian:bookworm-slim # 只用它的 nsenter（util-linux）
          securityContext: {privileged: true}
          env:
            - name: SAFE_ENROLL_TOKEN
              valueFrom:
                secretKeyRef: {name: safe-enroll, key: token, optional: true}
          command:
            - nsenter
            - --target=1
            - --mount
            - --uts
            - --ipc
            - --net
            - --
            - /var/lib/safe-agent-k8s/bin/safe-agent
            - -server
            - "{{.Servers}}"
            - -state
            - /var/lib/safe-agent-k8s/state.json
          resources:
            requests: {cpu: 20m, memory: 64Mi}
            limits: {cpu: 200m, memory: 256Mi}
          volumeMounts:
            - {name: state, mountPath: /var/lib/safe-agent-k8s}
      volumes:
        - name: state
          hostPath: {path: /var/lib/safe-agent-k8s, type: DirectoryOrCreate}
